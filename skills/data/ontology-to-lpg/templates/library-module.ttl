# A small released module, projected by the ontology-to-lpg skill's checks and tests. Copy it as a
# starting fixture for a projection's own tests; replace the library terms with your own.
# Rules: references/design-rules.md (1 to 5). Check it with:
#   uv run --no-project --with rdflib python3 <skill>/scripts/check_projection_rules.py \
#     --config projection-config.json --shapes library-shapes.ttl library-module.ttl
# To check the package pins too, lay it out as a release (references/inputs.md, rule 1):
#   mkdir -p releases/lending/1.1.0
#   cp library-module.ttl releases/lending/1.1.0/lending.ttl
#   cp library-shapes.ttl releases/lending/1.1.0/shapes.ttl
# and add --releases releases, naming releases/lending/1.1.0/lending.ttl and its shapes.ttl.

@prefix lib:     <https://id.example.org/library/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

lib:lending a owl:Ontology ;
    dcterms:title "Library lending"@en ;
    owl:versionInfo "1.1.0" .

# --- Classes. lib:Authorship is a qualified relation (Rule 4a): it only carries facts about one
#     work-to-person link. A loan would be a domain class instead: it has its own number.
lib:Work a owl:Class ; rdfs:label "Work"@en .
lib:Person a owl:Class ; rdfs:label "Person"@en .
lib:Copy a owl:Class ; rdfs:label "Copy"@en .
lib:Authorship a owl:Class ; rdfs:label "Authorship"@en .
# A subclass axiom, so the reason step has an inference to keep: W-0043 is asserted only as a book,
# and ELK infers that it is a work (references/pipeline.md, rules 4 and 6).
lib:Book a owl:Class ; rdfs:label "Book"@en ; rdfs:subClassOf lib:Work .

# --- Properties: one kind each; object and datatype properties one concrete range (Rule 1).
lib:title a owl:DatatypeProperty ; rdfs:label "title"@en ; rdfs:domain lib:Work ; rdfs:range rdf:langString .
lib:altTitle a owl:DatatypeProperty ; rdfs:label "alternative title"@en ; rdfs:domain lib:Work ; rdfs:range rdf:langString .
lib:name a owl:DatatypeProperty ; rdfs:label "name"@en ; rdfs:domain lib:Person ; rdfs:range xsd:string .
lib:barcode a owl:DatatypeProperty ; rdfs:label "barcode"@en ; rdfs:domain lib:Copy ; rdfs:range xsd:string .
lib:copyOf a owl:ObjectProperty ; rdfs:label "copy of"@en ; rdfs:domain lib:Copy ; rdfs:range lib:Work .
lib:hasAuthorship a owl:ObjectProperty ; rdfs:label "has authorship"@en ; rdfs:domain lib:Work ; rdfs:range lib:Authorship .
lib:authorshipAgent a owl:ObjectProperty ; rdfs:label "authorship agent"@en ; rdfs:domain lib:Authorship ; rdfs:range lib:Person .
lib:creatorRole a owl:ObjectProperty ; rdfs:label "creator role"@en ; rdfs:domain lib:Authorship ; rdfs:range skos:Concept .
lib:position a owl:DatatypeProperty ; rdfs:label "position"@en ; rdfs:domain lib:Authorship ; rdfs:range xsd:integer .
lib:source a owl:DatatypeProperty ; rdfs:label "source"@en ; rdfs:domain lib:Authorship ; rdfs:range xsd:string .
lib:shelfNote a owl:AnnotationProperty ; rdfs:label "shelf note"@en .

# --- Code list.
lib:creator-role a skos:ConceptScheme ; skos:prefLabel "Creator role"@en ; skos:hasTopConcept lib:author, lib:illustrator .
lib:author a skos:Concept ; skos:inScheme lib:creator-role ; skos:topConceptOf lib:creator-role ; skos:prefLabel "Author"@en .
lib:illustrator a skos:Concept ; skos:inScheme lib:creator-role ; skos:topConceptOf lib:creator-role ; skos:prefLabel "Illustrator"@en .

# --- Reference individuals: permanent IRIs, no blank nodes (Rule 3).
<https://id.example.org/library/work/W-0042> a lib:Work ;
    lib:title "The Lighthouse Keeper"@en ;
    lib:altTitle "Le Gardien du phare"@fr, "Der Leuchtturmwärter"@de ;
    lib:hasAuthorship <https://id.example.org/library/authorship/W-0042-P-17>,
                      <https://id.example.org/library/authorship/W-0042-P-18> .

<https://id.example.org/library/work/W-0043> a lib:Book ;
    lib:title "Night Trains"@en ;
    lib:hasAuthorship <https://id.example.org/library/authorship/W-0043-P-17> .

<https://id.example.org/library/person/P-17> a lib:Person ; lib:name "Ada Morgan" .
<https://id.example.org/library/person/P-18> a lib:Person ; lib:name "Ben Okafor" .

<https://id.example.org/library/authorship/W-0042-P-17> a lib:Authorship ;
    lib:authorshipAgent <https://id.example.org/library/person/P-17> ;
    lib:creatorRole lib:author ;
    lib:position 1 ;
    lib:source "Catalogue record 0042, field 100" .

<https://id.example.org/library/authorship/W-0042-P-18> a lib:Authorship ;
    lib:authorshipAgent <https://id.example.org/library/person/P-18> ;
    lib:creatorRole lib:illustrator ;
    lib:position 2 ;
    lib:source "Catalogue record 0042, field 700" .

<https://id.example.org/library/authorship/W-0043-P-17> a lib:Authorship ;
    lib:authorshipAgent <https://id.example.org/library/person/P-17> ;
    lib:creatorRole lib:author ;
    lib:position 1 ;
    lib:source "Catalogue record 0043, field 100" .

<https://id.example.org/library/copy/C-00420001> a lib:Copy ;
    lib:barcode "00420001" ;
    lib:copyOf <https://id.example.org/library/work/W-0042> ;
    lib:shelfNote "Spine label replaced 2026-03"@en .
